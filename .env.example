# EduVerse AI Kids - Production Environment Variables

# Django Core Settings
DEBUG=0
SECRET_KEY=production-super-secret-key-change-this-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,.eduverse.ai

# Gemini AI API Secret Key
GEMINI_API_KEY=your_production_gemini_api_key_here

# Database Configuration
POSTGRES_DB=eduverse_db
POSTGRES_USER=eduverse_user
POSTGRES_PASSWORD=eduverse_secure_password
DATABASE_URL=postgres://eduverse_user:eduverse_secure_password@db:5432/eduverse_db

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Email SMTP Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@eduverse.ai
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=EduVerse AI Kids <notifications@eduverse.ai>

# SMS Provider Credentials (Twilio / MSG91)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Provider Credentials (Gupshup)
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=EduVerseKids
